# Firebase configuration — copy this file to `.env` and fill in your project's values.
# Find these in Firebase console → Project settings → Your apps → SDK setup and configuration.
# Until these are set, the app runs on built-in sample/seed data (demo mode).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
