rules_version = '2';

// Firestore security rules for KKK Oil Factory ERP.
// Deploy with:  firebase deploy --only firestore:rules
//
// Model: any signed-in user (Email/Password auth) can read/write the ERP
// collections. Tighten per-collection or per-role as your team grows.
service cloud.firestore {
  match /databases/{database}/documents {

    // ERP data collections used by the app.
    function isErpCollection(name) {
      return name in [
        'brands', 'products', 'rawMaterials', 'suppliers', 'purchases',
        'production', 'customers', 'sales', 'dispatches', 'expenses'
      ];
    }

    match /{collection}/{docId} {
      allow read, write: if request.auth != null && isErpCollection(collection);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
